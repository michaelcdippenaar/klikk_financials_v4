# Copy this file to .env and fill in values before running docker-compose

# Django
DJANGO_SETTINGS_MODULE=klikk_business_intelligence.settings.staging
DJANGO_SECRET_KEY=change-me-use-secrets-token-urlsafe-50

# Media and Xero documents (app server e.g. 192.168.1.235). Uncomment and set on that host.
# MEDIA_ROOT=/var/data/klikk_financials_v4/media
XERO_DOCUMENTS_ROOT=/var/data/klikk_financials_v4/xero_documents

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,102.135.240.222

# Database (used by Django and the db service)
DB_NAME=klikk_financials_v4
DB_USER=klikk_user
DB_PASSWORD=change-me
# Postgres runs on the host machine, not inside Docker.
# Leave as host-gateway (resolved via extra_hosts in docker-compose.yml).
DB_HOST=host-gateway
DB_PORT=5432

# Shared service token for machine callers (the klikk-financials MCP server).
# Required to write to /api/pricelist/ (item upsert, item update, price add/close).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset => those writes are denied for token callers (a warning is logged once).
KLIKK_API_TOKEN=

# GitHub webhook (optional)
GITHUB_WEBHOOK_SECRET=

# Google Cloud / BigQuery (optional)
GOOGLE_APPLICATION_CREDENTIALS=

# AI Agent / OpenAI (optional)
# DO NOT commit real keys. Put real values in .env.local
AI_AGENT_OPENAI_API_KEY=
# Chat model: gpt-4o-mini, gpt-4o, gpt-5.2, gpt-5.2-instant, gpt-5.2-thinking, gpt-5.2-pro, gpt-5-mini
AI_AGENT_MODEL=gpt-5.2
AI_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# Web search (optional): get key at https://serper.dev to enable stock price, look up, real-time web search
SERPER_API_KEY=
# EOD Historical Data (optional): get key at https://eodhd.com/ — JSE stock data, fundamentals, bulk exchange tickers
EOD_API_KEY=

# Investec Programmable Banking (Private Bank Account Information API)
# Credentials from Investec Online > Programmable Banking > API keys.
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
# INVESTEC_BASE_URL=https://openapi.investec.com   # sandbox: https://openapisandbox.investec.com

# Additional credential profiles (e.g. spouse's account) — add _2, _3, ...
# The wife enables programmable banking on her OWN Investec profile and generates her OWN keys.
# INVESTEC_CLIENT_ID_2=
# INVESTEC_CLIENT_SECRET_2=
# INVESTEC_API_KEY_2=

# Personal-expenses owner labels: map Investec profileId (or accountNumber) -> owner label.
# INVESTEC_OWNER_MAP=profileId1=MC,profileId2=Wife
